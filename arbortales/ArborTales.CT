    <CheatEntry>
      <ID>41</ID>
      <Description>"Item Vac"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

aobscanmodule(ItemVacHook,ArborTales.exe,50 FF 75 DC 8D 45 CC 50 FF 15 ?? ?? ?? ?? 85 C0)
alloc(ItemVacMem,256,ItemVacHook)

label(return)

ItemVacMem:
  // RECT:
  // [ebp-34] = left
  // [ebp-30] = top
  // [ebp-2C] = right
  // [ebp-28] = bottom

  mov dword ptr [ebp-34],FFF0BDC0
  mov dword ptr [ebp-30],FFF0BDC0
  mov dword ptr [ebp-2C],000F4240
  mov dword ptr [ebp-28],000F4240

  // originele instructies
  push eax
  push [ebp-24]
  lea eax,[ebp-34]

  jmp return

ItemVacHook:
  jmp ItemVacMem
  nop 2

return:

registersymbol(ItemVacHook)


[DISABLE]

ItemVacHook:
  db 50 FF 75 DC 8D 45 CC

unregistersymbol(ItemVacHook)
dealloc(ItemVacMem)

</AssemblerScript>
    </CheatEntry>
